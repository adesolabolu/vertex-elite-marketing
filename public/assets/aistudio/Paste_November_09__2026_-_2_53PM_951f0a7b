<script>
document.addEventListener('DOMContentLoaded', () => {
  const testimonials = [
    {
      quote: "Vertex Elite didn't just give us a marketing plan; they gave us a new perspective on our own potential. Their strategic clarity is unmatched in the industry.",
      name: "Julian Sterling",
      title: "CEO, Sterling & Co.",
      image: "https://images.pexels.com/photos/26150470/pexels-photo-26150470.jpeg?w=80&h=80&fit=crop"
    },
    {
      quote: "The results speak for themselves. We've seen a 142% increase in digital revenue within the first six months of engagement with the Vertex team.",
      name: "Sarah Chen",
      title: "CMO, Aurora Collection",
      image: "https://images.pexels.com/photos/3756679/pexels-photo-3756679.jpeg?w=80&h=80&fit=crop"
    },
    {
      quote: "Vertex Elite bridges the gap between high-level brand strategy and ruthless performance execution. They are truly partners in our growth.",
      name: "Marcus Vane",
      title: "Founder, Vortex Systems",
      image: "https://images.pexels.com/photos/2182970/pexels-photo-2182970.jpeg?w=80&h=80&fit=crop"
    }
  ];

  let currentIdx = 0;
  const quoteEl = document.getElementById('testimonial-quote');
  const nameEl = document.getElementById('testimonial-name');
  const titleEl = document.getElementById('testimonial-title');
  const imageEl = document.getElementById('testimonial-image');
  const dots = document.querySelectorAll('.testimonial-dot');
  const slider = document.getElementById('testimonial-slider');

  function updateTestimonial(index) {
    // Fade out
    slider.style.opacity = '0';
    slider.style.transform = 'translateY(10px)';

    setTimeout(() => {
      const t = testimonials[index];
      quoteEl.textContent = `"${t.quote}"`;
      nameEl.textContent = t.name;
      titleEl.textContent = t.title;
      imageEl.src = t.image;

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-brand-primary', i === index);
        dot.classList.toggle('bg-brand-primary/20', i !== index);
        dot.classList.toggle('w-6', i === index);
        dot.classList.toggle('w-2.5', i !== index);
      });

      // Fade in
      slider.style.opacity = '1';
      slider.style.transform = 'translateY(0)';
    }, 500);
  }

  // Initial active state for the first dot
  dots[0].classList.add('w-6');

  setInterval(() => {
    currentIdx = (currentIdx + 1) % testimonials.length;
    updateTestimonial(currentIdx);
  }, 5000); // Change every 5 seconds
});
</script>
